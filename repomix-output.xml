                              <Button size="sm" variant="ghost" className="text-xs h-7 ml-auto" onClick={() => { setSelfMendCode(''); setSelfMendOutput(''); setSelfMendIssue(''); }}>
                                Clear
                              </Button>
                            </div>
                            {selfMendOutput && (
                              <div className="border rounded-md p-2.5 bg-background max-h-[300px] overflow-y-auto">
