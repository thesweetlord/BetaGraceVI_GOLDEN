  const fallbackPool = neighbors.length > 0
    ? neighbors
    : this.mem.interactions
        .slice()
        .sort((a, b) => (b.quality + (b.weight ?? 0)) - (a.quality + (a.weight ?? 0)))
        .slice(0, 3)
        .map((r) => ({
          ...r,
          similarity: 0.04,
          retrievalScore: Math.max(0.08, r.quality * 0.45 + (r.weight ?? 0) * 0.35),
