                          } catch {
                            // Fall through to standard renderer if JSON is malformed
                          }
                        }
                        return (
                          <Card className={cn(
                            message.role === 'user'
                              ? "bg-primary text-primary-foreground"
                              : "bg-muted/50",
                            isConfirming && "ring-2 ring-amber-400 dark:ring-amber-500"
