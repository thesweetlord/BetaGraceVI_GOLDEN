          imageMetricsCache.set(imageURL, selectedStyle, metrics);
        }

        const styleModelId = (STYLE_CONFIG[selectedStyle as keyof typeof STYLE_CONFIG]?.model) || 'flux';
        const matched = matchWeightsToImage(metrics, styleModelId);
