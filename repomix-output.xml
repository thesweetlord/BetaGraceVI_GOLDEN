                                disabled={selfMendMutation.isPending || !selfMendCode.trim()}
                              >
                                {selfMendMutation.isPending ? <Loader2 className="w-3 h-3 mr-1 animate-spin" /> : <Wrench className="w-3 h-3 mr-1" />}
