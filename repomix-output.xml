                      <div className="mt-1.5 h-1.5 rounded-full bg-emerald-100 dark:bg-emerald-900/40 overflow-hidden">
                        <div className="h-full bg-emerald-500 rounded-full animate-pulse" style={{ width: '15%' }} />
