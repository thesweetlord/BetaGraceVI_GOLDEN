  await test("Code Graph Mode [via /api/chat]: Returns intelligent analysis of code snippet", async () => {
    const sess = await createVerifiedSession("codegraph_chat");
    const { ok, body } = await req<{ success: boolean; response: string }>(
      "/api/chat",
