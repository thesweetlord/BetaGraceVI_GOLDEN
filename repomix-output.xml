                              </div>
                            )}

                            {/* Push to Code — write fixed code directly to a workspace file */}
                            {selfMendOutput && (
                              <div className="border border-dashed border-red-300 dark:border-red-700 rounded-md p-2.5 space-y-2 bg-red-50/40 dark:bg-red-950/20 mt-1">
