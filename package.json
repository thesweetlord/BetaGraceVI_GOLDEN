    "start": "node ./dist/index.cjs",
    "check": "node ./node_modules/typescript/bin/tsc",
    "test": "node -e \"process.env.BASE_URL='http://localhost:5000'; require('child_process').spawn(process.execPath, ['./node_modules/tsx/dist/cli.mjs', 'smoke-tests.ts'], { stdio: 'inherit', env: process.env }).on('exit', code => process.exit(code ?? 0));\"",
    "test:fast": "node -e \"process.env.BASE_URL='http://localhost:5000'; process.env.FAST='1'; require('child_process').spawn(process.execPath, ['./node_modules/tsx/dist/cli.mjs', 'smoke-tests.ts'], { stdio: 'inherit', env: process.env }).on('exit', code => process.exit(code ?? 0));\"",
    "db:push": "node ./node_modules/drizzle-kit/bin.cjs push",
    "migrate": "node ./node_modules/drizzle-kit/bin.cjs migrate",
    "migrate:up": "node ./node_modules/drizzle-kit/bin.cjs up",
    "client:dev": "node ./node_modules/vite/bin/vite.js",
    "client:build": "node ./node_modules/vite/bin/vite.js build"
  },
